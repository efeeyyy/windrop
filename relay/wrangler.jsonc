{
  // WinDrop aktarma sunucusu. Ayrıntı: docs/PROTOCOL.md §7.4 ve relay/README.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "windrop-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // İzleme/günlük kapalı: istek yolu (roomId) Cloudflare tarafında da saklanmasın.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "IP_LIMITER", "class_name": "IpLimiter" },
      { "name": "PUSH_REGISTRY", "class_name": "PushRegistry" }
    ]
  },
  // Ücretsiz planda yalnız SQLite tabanlı Durable Object sınıfları çalışır.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "IpLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["PushRegistry"] }
  ]
}
