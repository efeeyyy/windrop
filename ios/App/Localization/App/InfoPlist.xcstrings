            "state" : "translated",
            "value" : "WinDrop"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WinDrop"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WinDrop uses Bluetooth to find nearby computers and to signal them for file transfers."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WinDrop, yakındaki bilgisayarları Bluetooth ile bulmak ve dosya aktarımı için onlara sinyal göndermek üzere Bluetooth kullanır."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is needed to scan the QR code on your computer's screen for optional auto-accept pairing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı otomatik kabul eşleştirmesi için bilgisayarınızın ekranındaki QR kodu okumak üzere kamera gerekir."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local network access is needed to send files to or receive files from your computer on the same network."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı ağdaki bilgisayarınıza dosya göndermek veya ondan dosya almak için yerel ağa erişim gerekir."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission is needed to save photos and videos you receive from your computer to Photos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayardan aldığınız fotoğraf ve videoları Fotoğraflar'a kaydetmek için izin gerekir."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
