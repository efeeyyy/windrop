        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WinDrop, paylaştığınız dosyaları göndermek için yakındaki bilgisayarları Bluetooth ile bulur."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
