<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Yalnız ücretli geliştirici hesabı: "Release-Push" yapılandırmasıyla kullanılır (PUSH_ENABLED).
	     Değer imzalama sırasında sağlama profiline göre belirlenir (dağıtımda production). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Uygulama ve Paylaşım Uzantısı ortak cihaz kimliği/ayarları (project.yml `WinDropAppGroup`). Grup imzalamada
	     verilmezse çalışma zamanında algılanır ve uzantı kendi kimliğiyle çalışır. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(WINDROP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
