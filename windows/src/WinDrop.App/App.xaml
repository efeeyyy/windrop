<Application x:Class="WinDrop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinDrop.App.Infrastructure"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <infra:InverseBoolConverter x:Key="InvBool" />
        <infra:BoolToBrushConverter x:Key="NearbyBrush" TrueBrush="#6622AA55" FalseBrush="#40808080" />
        <!-- Hata metni rengi; koyu/açık temaya göre App.OnStartup'ta güncellenir (açık temada AA kontrast) -->
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    </Application.Resources>
</Application>
