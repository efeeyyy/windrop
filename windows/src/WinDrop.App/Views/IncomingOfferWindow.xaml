<Window x:Class="WinDrop.App.Views.IncomingOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:WinDrop.App.Infrastructure"
        Title="{infra:T Offer.Title}" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/app.ico">
    <!-- Odağı çalmaz (ShowActivated=False) ve varsayılan düğme yok: başka pencerede yazarken Enter/Boşluk teklifi KABUL ETMEZ. Esc = Reddet. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
        <TextBlock x:Name="FilesText" TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="FoldersText" TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="CodeText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="TimeoutText" Opacity="0.8" FontSize="12" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{infra:T Offer.Accept}" Click="OnAccept" MinWidth="90" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{infra:T Offer.Reject}" Click="OnReject" MinWidth="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
