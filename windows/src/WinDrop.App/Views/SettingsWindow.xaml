<Window x:Class="WinDrop.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:WinDrop.App.Infrastructure"
        Title="{infra:T Settings.Title}" Width="500" SizeToContent="Height" ResizeMode="CanResize" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="20,20,20,12">
                <!-- Aralıklar: grup arası 16, etiket-denetim arası 6 -->
                <TextBlock x:Name="FolderLabel" Text="{infra:T Settings.DownloadFolder}" FontWeight="SemiBold" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DownloadFolder}"
                             AutomationProperties.LabeledBy="{Binding ElementName=FolderLabel}" />
                    <Button Grid.Column="1" Content="{infra:T Settings.Browse}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding FolderError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Assertive" />

                <CheckBox Content="{infra:T Settings.AutoAccept}" IsChecked="{Binding AutoAccept}" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" Margin="24,8,0,0" IsEnabled="{Binding AutoAccept}">
                    <TextBlock x:Name="MaxLabel" Text="{infra:T Settings.AutoAcceptMax}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding AutoAcceptMaxText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="8,0,0,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=MaxLabel}" />
                </StackPanel>
                <TextBlock Text="{Binding MaxError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="24,4,0,0"
                           AutomationProperties.LiveSetting="Assertive" />

                <TextBlock x:Name="RelayLabel" Text="{infra:T Settings.RelayUrl}" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBox Text="{Binding RelayUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=RelayLabel}" />
                <TextBlock Text="{Binding RelayError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{infra:T Settings.RelayHelp}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="0,4,0,0" />

                <TextBlock x:Name="LanguageLabel" Text="{infra:T Settings.Language}" FontWeight="SemiBold" Margin="0,16,0,0" />
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedLanguage}" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="200"
                          AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" />
                <StackPanel Margin="0,6,0,0" Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{infra:T Settings.LangRestartNote}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                    <Button Content="{infra:T Settings.RestartNow}" Command="{Binding RestartNowCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <CheckBox Content="{infra:T Settings.SendTo}" IsChecked="{Binding SendToEnabled}" Margin="0,16,0,0" />
                <CheckBox Content="{infra:T Settings.AutoStart}" IsChecked="{Binding AutoStartEnabled}" Margin="0,8,0,0" />

                <TextBlock x:Name="PairedLabel" Text="{infra:T Settings.PairedDevices}" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBlock Text="{infra:T Settings.NoDevices}" Opacity="0.8"
                           Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}" />
                <StackPanel Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                    <!-- Cihaz listesi kendi içinde kaydırılır (en çok ~4 satır görünür) -->
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding PairedDevices}" AutomationProperties.LabeledBy="{Binding ElementName=PairedLabel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,4" AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.8" FontSize="11" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{infra:T Settings.Remove}" AutomationProperties.Name="{Binding RemoveLabel}"
                                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="{infra:T Settings.RemoveAll}" Command="{Binding RemoveAllDevicesCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Text="{Binding VersionText}" Opacity="0.8" FontSize="11" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Kaydet/Vazgeç altta sabit -->
        <StackPanel Grid.Row="1" Margin="20,0,20,16">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{infra:T Settings.Save}" Command="{Binding SaveCommand}" MinWidth="90" Margin="0,0,8,0" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="{infra:T Settings.Cancel}" Command="{Binding CancelCommand}" MinWidth="90" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
