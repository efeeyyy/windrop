<Window x:Class="WinDrop.App.Views.RelayApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:WinDrop.App.Infrastructure"
        Title="{infra:T Relay.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/app.ico">
    <!-- Veri kotası harcatan onay: odağı çalmaz, varsayılan düğme yok (Enter kazara onaylamaz). Esc = İptal. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="14" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0" />
        <TextBlock x:Name="TimeoutText" Opacity="0.8" FontSize="12" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{infra:T Relay.Confirm}" Click="OnConfirm" MinWidth="90" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{infra:T Relay.Cancel}" Click="OnCancel" MinWidth="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
